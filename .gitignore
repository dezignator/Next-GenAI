# =============================================================================
# Next-GenAI — .gitignore
# Reference: Ali & Chen (2024), Journal of Network and Computer Applications
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PYTHON
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# -----------------------------------------------------------------------------
# 2. PYTORCH / CAPSULE NETWORK ARTIFACTS
# -----------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.pb
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
checkpoints/
logs/
runs/
wandb/
mlruns/
tensorboard_logs/
torch_extensions/
*.safetensors

# -----------------------------------------------------------------------------
# 3. DATASETS & PREPROCESSED ARTIFACTS
# doh_real_world_2022 and derivatives must NEVER be committed.
# -----------------------------------------------------------------------------
data/
!data/README.md
!data/.gitkeep
datasets/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.zip
*.tar.gz
*.7z
*.rar
*.sqlite
*.db
*.lmdb

# -----------------------------------------------------------------------------
# 4. ADVERSARIAL / SYNTHETIC / THREAT-SIMULATION OUTPUTS
# -----------------------------------------------------------------------------
synthetic/
adversarial/
fuzzed/
mutations/
attacks_output/
polymorphic_samples/
tls_hijack_traces/
dns_tunnel_logs/

# -----------------------------------------------------------------------------
# 5. STREAMING PIPELINE (Kafka / Flink)
# -----------------------------------------------------------------------------
kafka-logs/
kafka-data/
flink-checkpoints/
flink-savepoints/
flink-logs/
stream_state/
*.flink
*.kafka
.confluent/
kafka-python-cache/

# -----------------------------------------------------------------------------
# 6. TRUSTED EXECUTION ENVIRONMENT (TEE) ARTIFACTS
# Never commit enclave signing keys, sealed data, or attestation binaries.
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
enclave.signed.so
enclave.debug.so
enclave.token
*.sgxs
*.enclave
attestation_reports/
sealed_data/
sgx_keys/
trustzone_keys/
tee_artifacts/
*.oe

# -----------------------------------------------------------------------------
# 7. ENVIRONMENT & SECRETS
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.yaml
secrets.yml
credentials.json
service_account.json
*.secret
config_override.yaml
config_local.yaml

# -----------------------------------------------------------------------------
# 8. IDE / EDITOR
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# 9. OS-SPECIFIC
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# 10. JUPYTER / NOTEBOOK OUTPUTS
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb.autosave
*.nbconvert.ipynb

# -----------------------------------------------------------------------------
# 11. TESTING & COVERAGE
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# -----------------------------------------------------------------------------
# 12. BUILD & DOCS
# -----------------------------------------------------------------------------
docs/_build/
docs/_static/generated/
site/
*.pdf
!docs/papers/*.pdf

# -----------------------------------------------------------------------------
# 13. STREAMLIT / DASHBOARD CACHE
# -----------------------------------------------------------------------------
.streamlit/secrets.toml
.streamlit/credentials.toml

# -----------------------------------------------------------------------------
# 14. MISC
# -----------------------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.log
!docs/logs/.gitkeep
